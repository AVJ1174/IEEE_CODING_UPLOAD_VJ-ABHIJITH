import java.util.LinkedList;
import java.util.Scanner;
class Node{
    int data ;
    Node next ;

    Node(int data){
        this.data=data ;
        this.next=null;
    }
}
public class W3E1 {
    public static Node createLinkedList(int n){
        Scanner input = new Scanner(System.in);
        if(n==0){
            return null ;
        }
        System.out.println("Enter Head Node: ");
        Node head = new Node(input.nextInt()) ;
        Node cur=head ;
        for(int i=1;i<n;i++){
            System.out.println("Enter Element "+(i+1)+":");
            cur.next=new Node(input.nextInt());
            cur=cur.next ;
        }
        return head;
    }
    public static Node deleteDuplicates(Node head ){
        if(head==null)
            return null;
            Node cur = head ;
            while(cur.next!=null){
                if(cur.data==cur.next.data){
                    cur.next=cur.next.next ;
                }else{
                    cur=cur.next;
                }
            }
            return head;
    }
    public static void display(Node head){
        if (head==null) return ;
        Node temp = head ;
        while(temp!=null){
            System.out.println(temp.data+" ");
            temp=temp.next ;
        }

    }
    public static void main(String S[] ){
        Scanner input = new Scanner(System.in);
        System.out.println("Enter Number of Elements :" );
        int n= input.nextInt() ;
        Node head = createLinkedList(n);
        head=deleteDuplicates(head);
        System.out.println("The Linked List after deleting duplicates : ") ;
        display(head) ;
    }
}
